diff --git a/device/softwinner/common/sepolicy/vendor/untrusted_app.te b/device/softwinner/common/sepolicy/vendor/untrusted_app.te
index 18f7746939..4a2b37a9e5 100644
--- a/device/softwinner/common/sepolicy/vendor/untrusted_app.te
+++ b/device/softwinner/common/sepolicy/vendor/untrusted_app.te
@@ -6,3 +6,19 @@ allow untrusted_app unlabeled:filesystem getattr;
 allow untrusted_app device:dir { open read };
 allow untrusted_app storage_stub_file:dir getattr;
 allow untrusted_app block_device:dir { read open search };
+
+# --- Debug access for APK: read-only access to UART nodes ---
+#
+# The Android security model forbids appdomain (which includes
+# untrusted_app, as it is a coredomain) from writing sysfs. Therefore
+# we can only grant READ permissions. To write GPIO pins or trigger
+# calibration, the APK must:
+#   * use shell uid (Runtime.exec) when running as adb shell, or
+#   * be promoted to priv_app with platform signature (out of scope here).
+#
+# Notes on what is and isn't allowed by system neverallow:
+#   - sysfs:file: coredomain.te:131 forbids all rw — DROP ALL rules.
+#   - sysfs_type:file (incl. sysfs_gpio): app_neverallows.te:99 forbids
+#     no_w — DROP all writes here too. Only read-only attributes survive.
+#   - serial_device:chr_file: no neverallow against appdomain — write OK.
+allow untrusted_app serial_device:chr_file { open read write ioctl getattr };
