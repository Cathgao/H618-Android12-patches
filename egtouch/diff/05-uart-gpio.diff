diff --git a/longan/kernel/linux-5.4/drivers/tty/serial/sunxi-uart.c b/longan/kernel/linux-5.4/drivers/tty/serial/sunxi-uart.c
index d8e6bf374a..1f5e6870c4 100644
--- a/longan/kernel/linux-5.4/drivers/tty/serial/sunxi-uart.c
+++ b/longan/kernel/linux-5.4/drivers/tty/serial/sunxi-uart.c
@@ -2247,11 +2247,16 @@ static int __init sunxi_uart_init(void)
 {
 	int ret;
 
 	ret = uart_register_driver(&sw_uart_driver);
 	if (unlikely(ret)) {
 		SERIAL_MSG("driver initializied\n");
 		return ret;
 	}
 
+	/* Set default baud rate to 115200 (8N1) for ttyAS devices */
+	sw_uart_driver.tty_driver->init_termios.c_cflag = B115200 | CS8 | CREAD | HUPCL | CLOCAL;
+	sw_uart_driver.tty_driver->init_termios.c_ispeed = 115200;
+	sw_uart_driver.tty_driver->init_termios.c_ospeed = 115200;
+
 	return platform_driver_register(&sw_uport_platform_driver);
 }
