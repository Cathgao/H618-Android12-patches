+# --- Debug access for APK: sysfs GPIO (legacy interface) ---
+/sys/class/gpio/export     0666    system      system
+/sys/class/gpio/unexport   0666    system      system
+/sys/class/gpio/gpio[0-9]*/direction    0666    system      system
+/sys/class/gpio/gpio[0-9]*/direction   0666    system      system
+/sys/class/gpio/gpio[0-9]*/value       0666    system      system
+/sys/class/gpio/gpio[0-9]*/edge        0666    system      system
+/sys/class/gpio/gpio[0-9]*/active_low  0666    system      system
